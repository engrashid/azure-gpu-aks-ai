# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive var files — never commit
terraform.tfvars
*.auto.tfvars

# Logs
/logs/*.log
/logs/drift-*.txt

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.idea/
.vscode/
*.swp
*.swo

# Lock files are committed for root modules only
**/modules/**/.terraform.lock.hcl
